{
  "name": "face-recognition-server",
  "version": "1.0.0",
  "description": "Real-time face recognition server using YuNet and SFace",
  "main": "server.js",
  "scripts": {
    "start": "node -r ./sqliteHook.js -r ./reportHook.js -r ./uiNoFlickerHook.js -r ./galleryHook.js -r ./uiFinalFixHook.js server.js",
    "dev": "node -r ./sqliteHook.js -r ./reportHook.js -r ./uiNoFlickerHook.js -r ./galleryHook.js -r ./uiFinalFixHook.js server.js",
    "reset-db": "node -r ./sqliteHook.js -e \"require('./db.js').resetAll()\""
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "cors": "^2.8.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "multer": "^1.4.5-lts.1",
    "ws": "^8.17.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "private": true
}
