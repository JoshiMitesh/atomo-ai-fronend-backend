# Enable Google Sheets event export
GOOGLE_SHEETS_ENABLED=true

# Spreadsheet ID from the Google Sheets URL
GOOGLE_SHEETS_ID=your_spreadsheet_id_here

# Existing worksheet/tab name
GOOGLE_SHEETS_TAB=Events

# Optional public address of this face-recognition server.
# When set, the Photo column becomes a clickable crop URL.
# Example: http://192.168.1.50:3000
PUBLIC_BASE_URL=

# Google service-account credentials.
# Recommended: point this to the downloaded JSON credentials file.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/google-service-account.json
